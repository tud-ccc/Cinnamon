# Activate this repository's pixi environment on entry, and load this
# machine's own configuration along with it.
#
# The files read below are gitignored and hold everything specific to a
# machine, so this file has no paths of its own and is the same everywhere.
# bash explicitly, because that is what direnv evaluates this file with,
# whatever your login shell is.

watch_file pixi.toml pixi.lock .env .upmem_env .envrc.local

# Build configuration: the generator, the cmake options, LLVM_PREBUILT.
#
# Before the pixi hook deliberately. common.sh treats .env as defaults that a
# variable already in the environment overrides, and pixi's activation is what
# sets CC and CXX -- loading .env afterwards would let a CC named there win
# over the compiler the environment was actually built with.
dotenv_if_exists .env

# Which environment to activate is a property of the machine too, so it is
# named in .env with everything else: `default` builds with pixi's own Clang,
# `host` with the compiler in CC and CXX (see BUILDING.md). This steers direnv
# only -- `pixi run` and `pixi shell` still need -e of their own.
#
# Not just `eval "$(...)"`: a name with no such environment makes shell-hook
# fail and print nothing, and evaluating that would silently leave the shell
# with no environment at all.
pixi_env="${PIXI_ENV:-default}"
if pixi_hook="$(pixi shell-hook -s bash -e "$pixi_env")"; then
  eval "$pixi_hook"
else
  log_error "pixi has no environment '$pixi_env' (PIXI_ENV in .env); nothing was activated"
fi

# The UPMEM SDK. UPMEM_HOME is what the makefiles and cinm-compile-dpu join
# onto, and its lib is where libdpu.so is found at run time.
#
# The SDK's bin stays off PATH: it ships a clang 12 DPU cross-compiler under
# the plain name `clang`, which is not a host compiler and would shadow one.
# Everything that needs a DPU tool names it through UPMEM_HOME instead.
if [ -f .upmem_env ]; then
  dotenv .upmem_env
  # Derived here rather than named in .upmem_env, so that it is added to
  # whatever is already there instead of replacing it.
  path_add LD_LIBRARY_PATH "$UPMEM_HOME/lib"
fi

# Anything else this machine needs, for which there is no variable to set in
# .env: an ssh-agent socket, a CUDA path, a pixi environment activated some
# other way. Gitignored, and last so that it can override what is above.
source_env_if_exists .envrc.local

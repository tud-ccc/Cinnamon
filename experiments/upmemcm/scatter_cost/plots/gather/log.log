int ix;
if (block_size <= 1023 && num_dpus <= 16) ix = 0;
else if (block_size <= 1023 && 16 < num_dpus && num_dpus <= 24) ix = 1;
else if (block_size <= 1023 && 24 < num_dpus && num_dpus <= 64) ix = 2;
else if (block_size <= 1023 && 64 < num_dpus && num_dpus <= 128) ix = 3;
else if (block_size <= 1023 && num_dpus > 128) ix = 4;

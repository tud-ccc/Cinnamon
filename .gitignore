### CMake Patch ###
# External projects
*-prefix/

# End of https://www.toptal.com/developers/gitignore/api/cmake
build-*
build
.cache
sandbox

# Third-party trees that are not submodules: vendor SDKs, generated
# scaffolding, and scratch checkouts.
/third-party/upmem
/third-party/upmem-src
# The Dockerfile build-alpine.sh generates for the gem5 image; the ALPINE
# sources themselves are a submodule.
/third-party/alpine/
/third-party/.venv/
# Unpacked by build-llvm.sh
/third-party/llvm-prebuilt/
/third-party/.llvm-prebuilt.*/

# Everything the tutorial notebooks generate: IR at each step, objects,
# cross-compiled binaries and gem5 output.
/tutorial/artifacts/

python/cinnamon/_resources
.env
**/__pycache__

.claude
.ruff_cache
